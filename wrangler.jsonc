// Cloudflare Workers config for www.ericcecchi.com (blank-slate issue 1615;
// plan: company/ops/ericcecchi-com-workers-move-plan.md in blank-slate).
//
// There is no Worker script: every page is pre-rendered at build time
// (react-router.config.ts) and served from ./build/client as static assets.
// Static asset requests are free and unlimited on the Free plan, and they
// don't count toward the account's 100,000 Worker requests a day, which
// blankslate.biz shares.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ericcecchi-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build/client",
    // /blog serves blog/index.html, and /blog/ answers 307 to /blog, so every
    // URL matches its canonical (no trailing slash). The default,
    // auto-trailing-slash, would send /blog to /blog/.
    "html_handling": "drop-trailing-slash",
    // Serve build/client/404.html, with a 404 status, for any path that has no
    // file. scripts/postbuild.mjs writes it from the catch-all route.
    "not_found_handling": "404-page"
  },
  // The DNS cutover (milestone M3, blank-slate issue 1617). A deploy of this
  // file attaches www.ericcecchi.com to the Worker as a Custom Domain: it
  // creates the DNS record and an Advanced Certificate, and it fails while the
  // old Vercel CNAME for www still exists. So this entry is deployed only at
  // the cutover, by hand, right after that CNAME is deleted (plan section 6).
  // The apex is not listed here: a proxied placeholder A record and a zone
  // redirect rule send ericcecchi.com to www.
  "routes": [{ "pattern": "www.ericcecchi.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, the PR preview deploy command (may be empty).
  "previews": {},
  // Off: nothing about a request is stored.
  "observability": { "enabled": false }
}
